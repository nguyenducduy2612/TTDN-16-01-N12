<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_meeting_room_tree" model="ir.ui.view">
        <field name="name">meeting.room.tree</field>
        <field name="model">meeting.room</field>
        <field name="arch" type="xml">
            <tree string="Danh sách phòng họp">
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
                <field name="status" widget="badge" decoration-success="status == 'free'" decoration-warning="status == 'occupied'" decoration-danger="status == 'maintenance'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_meeting_room_form" model="ir.ui.view">
        <field name="name">meeting.room.form</field>
        <field name="model">meeting.room</field>
        <field name="arch" type="xml">
            <form string="Phòng họp">
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Tên phòng..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="location"/>
                            <field name="capacity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thiết bị đi kèm">
                            <field name="equipment_ids">
                                <tree string="Thiết bị">
                                    <field name="ma_tai_san"/>
                                    <field name="ten_tai_san"/>
                                    <field name="trang_thai_thanh_ly"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_meeting_room" model="ir.actions.act_window">
        <field name="name">Phòng họp</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">meeting.room</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo phòng họp mới
            </p>
        </field>
    </record>
</odoo>
